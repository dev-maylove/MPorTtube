<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash, including Android 14/15. Keep icon centered and small enough for the system mask. -->
    <style name="Theme.MPorTtube.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_safe</item>
        <item name="windowSplashScreenIconBackgroundColor">#000000</item>
        <item name="postSplashScreenTheme">@style/Theme.MPorTtube</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
